{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "torinteo-markets-paper",
  "strategy": "REPLACE_WITH_REVIEWED_ISTRATEGY_SUBCLASS",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "spot",
  "timeframe": "15m",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "GBP",
  "position_adjustment_enable": false,
  "force_entry_enable": false,
  "cancel_open_orders_on_exit": true,
  "use_exit_signal": true,
  "exit_profit_only": false,
  "trailing_stop": false,
  "minimal_roi": {},
  "stoploss": -0.01,
  "unfilledtimeout": {"entry": 1, "exit": 1, "exit_timeout_count": 0, "unit": "minutes"},
  "order_types": {
    "entry": "limit", "exit": "market", "emergency_exit": "market",
    "stoploss": "market", "stoploss_on_exchange": false
  },
  "order_time_in_force": {"entry": "GTC", "exit": "GTC"},
  "entry_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exchange": {
    "name": "REPLACE_WITH_SUPPORTED_EXCHANGE",
    "key": "", "secret": "",
    "pair_whitelist": ["BTC/USDT"], "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "telegram": {"enabled": false},
  "api_server": {"enabled": false},
  "initial_state": "stopped",
  "internals": {"process_throttle_secs": 5}
}
